          "args": {
            "key": "dp",
            "question": "deploy checklist"
          }
        },
        {
          "op": "standing_invalidate",
          "subject": "alice",
          "args": {
            "key": "dp",
            "question": "deploy checklist"
          }
        }
      ],
      "probe": {
        "op": "standing_read",
